---
import SectionHeading from './SectionHeading.astro';

const roles = [
  {
    title: 'Presidente de Syste+',
    subtitle: 'Asociación de Estudiantes de Ingeniería de Sistemas · Univ. del Magdalena',
    period: '2026-II — 2027-I',
    description:
      'Represento y lidero a la asociación estudiantil del programa, impulsando actividades académicas, comunidad y participación estudiantil.',
    icon: '<path d="M2 8l4 4 6-7 6 7 4-4-1.5 10.5h-17L2 8z" /><line x1="5" y1="21" x2="19" y2="21" />',
  },
  {
    title: 'Líder de CILISP',
    subtitle: 'Comunidad de Linux, Scripting y Programación de Bajo Nivel',
    period: 'Actualidad',
    description:
      'Lidero una comunidad de estudio donde promuevo la investigación en Linux, scripting y bajo nivel, acompañando a estudiantes interesados que no saben cómo empezar a aprender.',
    icon: '<polyline points="4 17 10 11 4 5" /><line x1="12" y1="19" x2="20" y2="19" />',
  },
  {
    title: 'Semillero GIDSYC',
    subtitle: 'Grupo de Investigación y Desarrollo en Sistemas y Computación',
    period: 'Empezando',
    description:
      'Empezando a involucrarme en el semillero de investigación, con interés en sistemas, computación y aprendizaje automático.',
    icon: '<path d="M9 3h6" /><path d="M10 3v5.5L4.5 18a2 2 0 0 0 1.8 3h11.4a2 2 0 0 0 1.8-3L14 8.5V3" /><line x1="7.5" y1="14" x2="16.5" y2="14" />',
  },
];
---

<section id="leadership" class="py-24 md:py-32 px-6">
  <div class="max-w-6xl mx-auto">
    <SectionHeading index="03" command="cat liderazgo.md">
      Liderazgo e <span class="text-primary">investigación</span>
    </SectionHeading>

    <div class="max-w-3xl mx-auto relative">
      <div class="absolute left-[27px] top-3 bottom-3 w-px bg-gradient-to-b from-primary/40 via-white/10 to-transparent"></div>

      <div class="space-y-6">
        {
          roles.map((item) => (
            <div class="reveal relative flex gap-5">
              <div class="relative z-10 p-3 rounded-xl bg-surface border border-primary/20 text-primary h-fit shrink-0 shadow-[0_0_20px_-5px_rgba(37,99,235,0.5)]">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
              </div>
              <div class="flex-1 p-6 rounded-2xl bg-surface border border-white/5 hover:border-primary/20 transition-all duration-300 group">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-1 sm:gap-4">
                  <div class="min-w-0">
                    <h3 class="text-lg sm:text-xl font-bold text-white break-words">{item.title}</h3>
                    <p class="text-sm sm:text-base text-primary font-medium">{item.subtitle}</p>
                  </div>
                  <span class="term-prompt text-xs sm:text-sm text-primary-light whitespace-nowrap bg-primary/10 border border-primary/20 px-2.5 sm:px-3 py-1 rounded-lg self-start">
                    [{item.period}]
                  </span>
                </div>
                <p class="text-gray-400 mt-2">{item.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
