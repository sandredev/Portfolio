---
import SectionHeading from './SectionHeading.astro';

const skillGroups = [
  { slug: '~/lenguajes', title: 'Lenguajes principales', level: 4, skills: ['C', 'C++', 'Python', 'Java', 'JavaScript'] },
  { slug: '~/sistemas', title: 'Sistemas y bajo nivel', level: 4, skills: ['Linux', 'Bash / Scripting', 'CMake', 'Git', 'Git Flow'] },
  { slug: '~/cs-fundamentals', title: 'CS fundamentals', level: 3, skills: ['Sistemas operativos', 'Compiladores', 'Gramáticas', 'Parsing'] },
  { slug: '~/ml-data', title: 'ML & Data', level: 3, skills: ['Machine Learning (en formación)', 'Deep Learning (en formación)', 'Python científico (en formación)'] },
  { slug: '~/web', title: 'Web (secundario)', level: 3, skills: ['React', 'TailwindCSS', 'Supabase', 'Vercel'] },
  { slug: '~/db', title: 'Bases de datos', level: 3, skills: ['SQLServer', 'PostgreSQL', 'Supabase'] },
  { slug: '~/agentes', title: 'Automatización con agentes', level: 4, skills: ['OpenCode', 'Agentes de código IA', 'Automatización de flujos'] },
  { slug: '~/herramientas', title: 'Herramientas', level: 5, skills: ['GitHub', 'VS Code', 'IntelliJ IDEA'] },
  { slug: '~/idiomas', title: 'Idiomas', level: 5, skills: ['Español (nativo)', 'Inglés (fluido)'] },
];

const softSkills = [
  'Liderazgo',
  'Comunicación efectiva',
  'Resolución de problemas',
  'Adaptabilidad',
  'Mentalidad investigativa',
  'Mentoría a principiantes',
];
---

<section id="skills" class="py-24 md:py-32 px-6">
  <div class="max-w-6xl mx-auto">
    <SectionHeading index="06" command="ls ~/skills">
      Habilidades
    </SectionHeading>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {
        skillGroups.map((group) => (
          <div class="card-glow reveal rounded-2xl bg-surface border border-white/5 overflow-hidden hover:border-primary/20">
            <div class="flex items-center gap-2 px-4 py-2.5 border-b border-white/5 bg-black/30">
              <span class="term-prompt text-[11px] text-gray-500 truncate">
                <span class="text-primary-light/80">$</span> {group.slug}
              </span>
              <span class="ml-auto flex gap-1" title={`Nivel ${group.level}/5`}>
                {Array.from({ length: 5 }).map((_, i) => (
                  <span class={`w-1.5 h-1.5 rounded-full ${i < group.level ? 'bg-primary shadow-[0_0_6px_rgba(37,99,235,0.8)]' : 'bg-white/10'}`}></span>
                ))}
              </span>
            </div>
            <div class="p-6">
              <h3 class="font-bold text-white mb-4">{group.title}</h3>
              <div class="flex flex-wrap gap-2">
                {group.skills.map((skill) => (
                  <span class="px-3 py-1.5 text-xs font-medium text-gray-300 bg-white/5 rounded-lg">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <h3 class="reveal term-prompt text-xl md:text-2xl font-bold text-white text-center mb-8">
      <span class="text-gray-600">$</span> Habilidades <span class="text-primary">blandas</span>
    </h3>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        softSkills.map((label) => (
          <div class="reveal card-glow text-center p-6 rounded-2xl bg-surface border border-white/5 hover:border-primary/20">
            <h4 class="text-white font-medium">{label}</h4>
          </div>
        ))
      }
    </div>
  </div>
</section>
