---
const { index, command } = Astro.props;
---

<div class="reveal text-center mb-16">
  <p class="term-prompt text-xs text-primary-light/90 mb-4 tracking-wider">
    <span class="text-gray-600">~/portfolio $</span> {command}
  </p>
  <h2 class="term-prompt text-3xl md:text-4xl font-bold text-white mb-4">
    <span class="text-primary">{index}.</span>
    <slot />
  </h2>
  <div class="w-20 h-1 bg-primary rounded-full mx-auto"></div>
</div>
