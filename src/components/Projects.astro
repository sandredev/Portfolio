---
import SectionHeading from './SectionHeading.astro';

const projects = [
  {
    title: 'Math_Parser',
    file: 'math_parser.cpp',
    lang: 'C++',
    description:
      'Parser en C++ que resuelve expresiones matemáticas con funciones trigonométricas. Incluye gramática formal (grammar.txt), compilación con CMake y suite de pruebas. Proyecto ligado a mi estudio de compiladores y programación de bajo nivel.',
    tags: ['C++', 'Parsing', 'Gramáticas', 'CMake'],
    url: 'https://github.com/sandredev/Math_Parser',
    github: 'https://github.com/sandredev/Math_Parser',
  },
  {
    title: 'Sandwiches Otto',
    file: 'sandwiches-otto/',
    lang: 'TypeScript',
    description:
      'Aplicación web usada por el emprendimiento Sándwiches Otto en la Universidad del Magdalena para registrar ventas, generar reportes y analizar estadísticas. Stack con React, TailwindCSS y Supabase, con flujo Git Flow, Conventional Commits y despliegue en Vercel.',
    tags: ['React', 'TailwindCSS', 'Supabase', 'Vercel'],
    url: 'https://sandwiches-otto.vercel.app',
    github: 'https://github.com/ravenminddev/sandwiches-otto',
  },
];
---

<section id="projects" class="py-24 md:py-32 px-6">
  <div class="max-w-6xl mx-auto">
    <SectionHeading index="02" command="ls ~/proyectos --destacados">
      Proyectos <span class="text-primary">destacados</span>
    </SectionHeading>

    <div class="grid md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <article class="card-glow group relative bg-surface rounded-2xl border border-white/5 overflow-hidden hover:border-primary/30">
            <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>

            <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5 bg-black/30">
              <span class="w-3 h-3 rounded-full bg-[#ff5f57]"></span>
              <span class="w-3 h-3 rounded-full bg-[#febc2e]"></span>
              <span class="w-3 h-3 rounded-full bg-[#28c840]"></span>
              <span class="term-prompt ml-2 text-xs text-gray-500 truncate">{project.file}</span>
              <span class="term-prompt ml-auto hidden sm:inline text-[10px] uppercase tracking-wider text-primary-light/70 border border-primary/20 bg-primary/10 rounded px-1.5 py-0.5">
                {project.lang}
              </span>
            </div>

            <div class="relative p-8">
              <div class="flex items-start justify-between mb-4">
                <h3 class="text-2xl font-bold text-white group-hover:text-primary transition-colors duration-300">
                  {project.title}
                </h3>
                <div class="flex gap-3">
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Abrir ${project.title}`}
                    class="p-2 rounded-lg text-gray-400 hover:text-primary hover:bg-primary/10 transition-all"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <polyline points="15 3 21 3 21 9" />
                      <line x1="10" y1="14" x2="21" y2="3" />
                    </svg>
                  </a>
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`GitHub de ${project.title}`}
                    class="p-2 rounded-lg text-gray-400 hover:text-primary hover:bg-primary/10 transition-all"
                  >
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                  </a>
                </div>
              </div>

              <p class="text-gray-400 leading-relaxed mb-6">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="px-3 py-1.5 text-xs font-medium text-primary bg-primary/10 rounded-lg">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="reveal term-prompt text-center mt-12 text-sm text-gray-400">
      <span class="text-gray-600">$</span> más proyectos en
      <a
        href="https://github.com/sandredev"
        target="_blank"
        rel="noopener noreferrer"
        class="text-primary hover:text-primary-light underline underline-offset-4 transition-colors"
      >
        github.com/sandredev
      </a>
      <span class="term-caret"></span>
    </p>
  </div>
</section>
