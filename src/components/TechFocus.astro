---
const focuses = [
  {
    title: 'Sistemas y compiladores',
    items: ['C / C++', 'Diseño de SO', 'Parsing y gramáticas'],
    icon: '<rect x="5" y="5" width="14" height="14" rx="2" /><rect x="9.5" y="9.5" width="5" height="5" /><line x1="9" y1="2" x2="9" y2="5" /><line x1="15" y1="2" x2="15" y2="5" /><line x1="9" y1="19" x2="9" y2="22" /><line x1="15" y1="19" x2="15" y2="22" /><line x1="2" y1="9" x2="5" y2="9" /><line x1="2" y1="15" x2="5" y2="15" /><line x1="19" y1="9" x2="22" y2="9" /><line x1="19" y1="15" x2="22" y2="15" />',
  },
  {
    title: 'Linux y scripting',
    items: ['Linux', 'Bash / Scripting', 'Programación de bajo nivel'],
    icon: '<polyline points="4 17 10 11 4 5" /><line x1="12" y1="19" x2="20" y2="19" />',
  },
  {
    title: 'ML & Deep Learning',
    items: ['Estudiando y profundizando', 'Python'],
    icon: '<circle cx="6" cy="6" r="2.5" /><circle cx="6" cy="18" r="2.5" /><circle cx="18" cy="12" r="2.5" /><line x1="8.3" y1="7.2" x2="15.7" y2="10.8" /><line x1="8.3" y1="16.8" x2="15.7" y2="13.2" />',
  },
  {
    title: 'Agentes de código',
    items: ['OpenCode', 'Automatización de flujos'],
    icon: '<rect x="5" y="10" width="14" height="10" rx="2" /><line x1="12" y1="10" x2="12" y2="4" /><circle cx="12" cy="3" r="1" /><circle cx="9.5" cy="15" r="1" /><circle cx="14.5" cy="15" r="1" /><line x1="9.5" y1="18" x2="14.5" y2="18" />',
  },
  {
    title: 'Web (secundario)',
    items: ['React', 'TailwindCSS', 'Supabase'],
    icon: '<circle cx="12" cy="12" r="9" /><line x1="3" y1="12" x2="21" y2="12" /><path d="M12 3a13.5 13.5 0 0 1 0 18a13.5 13.5 0 0 1 0-18z" />',
  },
];
---

<section id="tech-focus" class="py-24 md:py-32 px-6">
  <div class="max-w-6xl mx-auto">
    <div class="reveal text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
        Enfoque <span class="text-primary">técnico</span>
      </h2>
      <div class="w-20 h-1 bg-primary rounded-full mx-auto"></div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        focuses.map((item) => (
          <div class="reveal p-6 rounded-2xl bg-surface border border-white/5 hover:border-primary/20 transition-all duration-300 group">
            <div class="p-3 rounded-xl bg-primary/10 text-primary w-fit mb-5 group-hover:bg-primary/20 transition-colors">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            </div>
            <h3 class="text-lg font-bold text-white mb-3">{item.title}</h3>
            <ul class="space-y-2">
              {item.items.map((i) => (
                <li class="text-gray-400 text-sm flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary/60"></span>
                  {i}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-12 p-6 rounded-2xl bg-gradient-to-r from-primary/10 to-transparent border border-primary/10 text-center">
      <p class="text-gray-300 text-lg">
        Mi prioridad es la
        <span class="text-white font-semibold">investigación en sistemas</span>:
        diseño de SO, compiladores y Linux con C/C++, al mismo tiempo que profundizo en
        <span class="text-white font-semibold">Machine Learning</span> y
        <span class="text-white font-semibold">Deep Learning</span>. El desarrollo web
        queda como un interés <span class="text-white font-semibold">secundario</span>.
      </p>
    </div>
  </div>
</section>
